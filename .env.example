# 複製此檔為 .env 並填入自己的帳號資訊（.env 不會進入版控）
# GDMS 會員帳號（https://gdms.cwa.gov.tw/ 免費註冊）
GDMS_USER=your_email@example.com
GDMS_PASS=your_password

# 若腳本登入被 reCAPTCHA 擋下，改用瀏覽器登入後複製 cookie（教學見第 2 章）
# GDMS_COOKIE=PHPSESSID=xxxxxxxxxxxxxxxx

# 氣象署開放資料平臺授權碼（https://opendata.cwa.gov.tw/ 免費註冊取得）
# CWA_API_KEY=CWA-XXXXXXXX-XXXX-XXXX-XXXX-XXXXXXXXXXXX
