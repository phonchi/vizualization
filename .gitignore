# 帳密與金鑰
.env

# Python
__pycache__/
*.pyc
.venv/
.ipynb_checkpoints/
*.egg-info/

# 建置產物（根目錄殘留與 book 產出）
_build/

# Jupyter Book 產出
book/_build/

# 下載的資料快取（範例資料 data/sample/ 會進版控，下載快取不進）
data/cache/

# 參考文獻 PDF 與程式庫（版權與審稿中資料，不進版控；筆記 notes/ 要進）
reference/*
!reference/notes/

# Windows 下載殘留
*Zone.Identifier
desktop.ini
